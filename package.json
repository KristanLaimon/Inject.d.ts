{
  "name": "inject-d-ts",
  "publisher": "KristanLaimon",
  "displayName": "Inject.d.ts",
  "description": "Zero-config TypeScript IntelliSense for projects and loose scripts without per-project type installs.",
  "version": "0.0.18",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/KristanLaimon/Inject.d.ts"
  },
  "homepage": "https://github.com/KristanLaimon/Inject.d.ts#readme",
  "bugs": {
    "url": "https://github.com/KristanLaimon/Inject.d.ts/issues"
  },
  "engines": {
    "vscode": "^1.115.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:inject-d-ts.packages",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "typescriptServerPlugins": [
      {
        "name": "inject-d-ts-tsserver-plugin",
        "enableForWorkspaceTypeScriptVersions": true
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "inject-d-ts",
          "title": "Inject.d.ts",
          "icon": "resources/inject-d-ts.svg"
        }
      ]
    },
    "views": {
      "inject-d-ts": [
        {
          "id": "inject-d-ts.packages",
          "name": "Global Types",
          "icon": ""
        }
      ]
    },
    "commands": [
      {
        "command": "inject-d-ts.downloadPackage",
        "title": "Download Types Package",
        "icon": "$(cloud-download)"
      },
      {
        "command": "inject-d-ts.editPackage",
        "title": "Change Types Package Version",
        "icon": "$(edit)"
      },
      {
        "command": "inject-d-ts.deletePackage",
        "title": "Delete Types Package",
        "icon": "$(trash)"
      },
      {
        "command": "inject-d-ts.refresh",
        "title": "Refresh Global Types",
        "icon": "$(refresh)"
      },
      {
        "command": "inject-d-ts.openStorage",
        "title": "Open Types Storage",
        "icon": "$(folder-opened)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "inject-d-ts.downloadPackage",
          "when": "view == inject-d-ts.packages",
          "group": "navigation"
        },
        {
          "command": "inject-d-ts.refresh",
          "when": "view == inject-d-ts.packages",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "inject-d-ts.editPackage",
          "when": "view == inject-d-ts.packages && viewItem =~ /TypePackage$/",
          "group": "inline"
        },
        {
          "command": "inject-d-ts.deletePackage",
          "when": "view == inject-d-ts.packages && viewItem =~ /TypePackage$/",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "node scripts/vscode-prepublish.mjs",
    "compile": "pnpm run check-types && pnpm run lint && bun esbuild.js && pnpm run prepare-tsserver-plugin",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "bun esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && bun esbuild.js --production && pnpm run prepare-tsserver-plugin",
    "prepare-tsserver-plugin": "node scripts/prepare-tsserver-plugin-package.mjs",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "@types/node": "22.x",
    "inject-d-ts-tsserver-plugin": "file:./tsserver-plugin",
    "semver": "^7.7.3",
    "tar": "^7.5.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/semver": "^7.7.1",
    "@types/vscode": "1.115.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "packageManager": "pnpm@11.1.1",
  "private": false

}